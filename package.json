{
  "name": "ai-code-review-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI Code Review — Intelligent AI-Powered Code Analysis & Review Platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.64.1"
  }
}
