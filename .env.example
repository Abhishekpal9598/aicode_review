# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL Primary)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=aicode_review
# If using SQLite dev fallback:
# DB_CLIENT=sqlite3
# DB_FILENAME=./dev.sqlite3

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM Configuration
# Set ANTHROPIC_API_KEY to your API key, or leave as 'mock' for mock review mode
ANTHROPIC_API_KEY=mock
LLM_MODEL=claude-sonnet-5-5

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
