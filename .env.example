# Root .env.example — for reference only
# Use server/.env.example for backend configuration
# Use client/.env.example for frontend configuration

# =========================================================
# BACKEND (server/.env)
# =========================================================
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aicode_review?retryWrites=true&w=majority

# IMPORTANT: Use a strong, random 64-character secret in production
JWT_SECRET=your_super_secret_jwt_entropy_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

TRUST_PROXY=1
HEALTH_RATE_LIMIT_MAX=60

# =========================================================
# FRONTEND (client/.env)
# =========================================================
# Uses relative /api path with Vite proxy in development.
# In production (Vercel), vercel.json rewrites /api/* to the Render backend.
VITE_API_BASE_URL=/api

