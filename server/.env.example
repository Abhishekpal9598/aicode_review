# Server Configuration
PORT=5001
NODE_ENV=development

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database (MongoDB Local / Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aicode_review?retryWrites=true&w=majority

# Authentication & JWT Security
JWT_SECRET=your_super_secret_jwt_entropy_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Gemini AI Integration
# Required for AI review generation; if omitted, platform operates in deterministic static fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# Proxy & Rate Limiting
TRUST_PROXY=1
HEALTH_RATE_LIMIT_MAX=60

